{
  "extends": "@jayyuen66/dsh-plugin-shared/config/tsconfig.base.json",
  "compilerOptions": {
    // DOM 是为 test/ 加的，不是给 host.ts / lib/ 的：test/client-ui.test.ts 把客户端组件挂进
    // 一个 window/document 夹具里，要 HTMLElement / HTMLButtonElement 这些类型。
    // 代价是这个程序同时覆盖 host.ts 与 lib/**：宿主侧代码里误写 document/window 时 tsc 不会
    // 拦（运行期在 Node 里必然 ReferenceError）。唯一兜底是 code review——oxlint 基线
    // （@jayyuen66/dsh-plugin-shared/config/oxlint）里没有禁用 window/document 的规则。
    // 把 DOM 拆给只覆盖 test/ 的程序要给 test/ 自己的 tsconfig 多跑一次 tsc；typecheck 已经是
    // 三条 tsc 串联，代价不是「一条命令变两条」而只是多一条腿。在宿主侧零 DOM 引用（已实测）
    // 的前提下，这里的取舍是留着一处注释，而不是多一条构建腿。
    "lib": ["ES2024", "DOM", "DOM.Iterable"]
  },
  "include": ["*.ts", "lib/**/*.ts", "test/**/*.ts"]
}
