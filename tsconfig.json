{
  "extends": "@jayyuen66/dsh-plugin-shared/config/tsconfig.base.json",
  "compilerOptions": {
    // DOM 是为 test/ 加的，不是给 host.ts / lib/ 的：test/client-ui.test.ts 把客户端组件挂进
    // 一个 window/document 夹具里，要 HTMLElement / HTMLButtonElement 这些类型。
    // 代价是这个程序同时覆盖 host.ts 与 lib/**：宿主侧代码里误写 document/window 时 tsc 不会
    // 拦（运行期在 Node 里必然 ReferenceError），只能靠 code review 与 oxlint 挡。把 DOM 拆给
    // 一个只覆盖 test/ 的程序需要让 test/ 有自己的 tsconfig 并给那套程序单独跑一次 tsc，
    // 而那会把「一条命令查完整仓」拆成两条——在宿主侧零 DOM 引用（已实测）的前提下，
    // 这里的取舍是留着一处注释，而不是多一条构建腿。
    "lib": ["ES2024", "DOM", "DOM.Iterable"]
  },
  "include": [
    "host.ts",
    "lib/**/*.ts",
    "test/**/*.ts",
    "vitest.config.ts",
    "vitest.integration.config.ts",
    "vitest.property.config.ts",
    "oxlint.config.ts"
  ]
}
