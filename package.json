{
  "name": "@jayyuen66/dsh-session-rescue",
  "version": "0.1.6",
  "description": "Session rescue for dsh web: auto-resume on transient model failures, max-tokens continuation and unclosed-todo catch-up (host), plus edit-resend / retry / queue-withdraw / stop-and-reask / settings card (client).",
  "keywords": [
    "cordis",
    "dsh",
    "llm-retry",
    "plugin",
    "session-resume"
  ],
  "homepage": "https://github.com/JayYuen666/dsh-session-rescue#readme",
  "bugs": {
    "url": "https://github.com/JayYuen666/dsh-session-rescue/issues"
  },
  "license": "MIT",
  "author": {
    "name": "JayYuen",
    "url": "https://github.com/JayYuen666"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JayYuen666/dsh-session-rescue.git"
  },
  "files": [
    "icon.svg",
    "locale/zh.json",
    "locale/en.json",
    "docs",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "host.js",
    "client.js",
    "types",
    "cordis.patch.yml"
  ],
  "type": "module",
  "main": "host.js",
  "types": "./types/host.d.ts",
  "exports": {
    ".": {
      "types": "./types/host.d.ts",
      "default": "./host.js"
    },
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/en.json": "./locale/en.json",
    "./locale/zh.json": "./locale/zh.json",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build:client": "node build-client.mjs",
    "build": "node build-host.mjs",
    "build:types": "node build-types.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.client.json && tsc --noEmit -p tsconfig.build-scripts.json",
    "lint": "oxlint .",
    "test": "vitest run --coverage",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "test:property": "vitest run -c vitest.property.config.ts",
    "test:e2e": "vitest run -c vitest.e2e.config.ts",
    "test:platform": "vitest run -c vitest.platform.config.ts",
    "test:watch": "vitest",
    "check": "npm run --loglevel=warn typecheck && npm run --loglevel=warn lint && npm run --loglevel=warn build:client && npm run --loglevel=warn build && npm run --loglevel=warn build:types && npm run --loglevel=warn test && npm run --loglevel=warn test:integration && npm run --loglevel=warn test:property && npm run --loglevel=warn test:e2e && npm run --loglevel=warn test:platform && npm run --loglevel=warn fmt:check",
    "fmt:check": "oxfmt --check .",
    "prepare": "npm run --loglevel=warn build:client && npm run --loglevel=warn build && npm run --loglevel=warn build:types"
  },
  "dependencies": {
    "@jayyuen66/dsh-plugin-shared": "catalog:",
    "zod": "catalog:"
  },
